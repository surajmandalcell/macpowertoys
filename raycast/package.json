{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "macpowertoys",
  "title": "MacPowerToys",
  "author": "surajmandal",
  "description": "Launch focused MacPowerToys utilities from Raycast.",
  "icon": "extension-icon.png",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Developer Tools",
    "System"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "macpowertoys",
      "title": "MacPowerToys",
      "description": "Open MacPowerToys",
      "mode": "no-view"
    },
    {
      "name": "claude-history",
      "title": "Claude History",
      "description": "Open Claude History",
      "mode": "no-view"
    },
    {
      "name": "cloud-sync",
      "title": "Cloud Sync",
      "description": "Open Cloud Sync",
      "mode": "no-view"
    },
    {
      "name": "logs",
      "title": "Logs",
      "description": "Open Logs",
      "mode": "no-view"
    },
    {
      "name": "ruler",
      "title": "Ruler",
      "description": "Open Ruler",
      "mode": "no-view"
    },
    {
      "name": "awake",
      "title": "Awake",
      "description": "Open Awake",
      "mode": "no-view"
    },
    {
      "name": "color-picker",
      "title": "Color Picker",
      "description": "Open Color Picker",
      "mode": "no-view"
    },
    {
      "name": "text-extractor",
      "title": "Text Extractor",
      "description": "Open Text Extractor",
      "mode": "no-view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.23"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "22.15.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "lint": "eslint . && prettier --check .",
    "lint:store": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
