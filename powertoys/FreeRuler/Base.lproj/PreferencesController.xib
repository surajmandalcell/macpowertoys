<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24506" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES" customObjectInstantitationMethod="direct">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24506"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="PreferencesController" customModule="powertoys" customModuleProvider="target">
            <connections>
                <outlet property="resetFactoryDefaultsButton" destination="PREF-factory-button" id="PREF-factory-outlet"/>
                <outlet property="settingsControlsView" destination="PREF-controls" id="PREF-controls-outlet"/>
                <outlet property="window" destination="F0z-JX-Cv5" id="gIp-Ho-8D9"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <window title="Ruler Defaults" allowsToolTipsWhenApplicationIsInactive="NO" autorecalculatesKeyViewLoop="NO" restorable="NO" releasedWhenClosed="NO" frameAutosaveName="preferencesWindow" animationBehavior="default" titlebarAppearsTransparent="YES" id="F0z-JX-Cv5">
            <windowStyleMask key="styleMask" titled="YES" closable="YES" miniaturizable="YES"/>
            <rect key="contentRect" x="602" y="400" width="420" height="500"/>
            <rect key="screenRect" x="0.0" y="0.0" width="1512" height="944"/>
            <customView key="contentView" id="PREF-content" customClass="UtilityMaterialView" customModule="powertoys" customModuleProvider="target">
                <rect key="frame" x="0.0" y="0.0" width="420" height="500"/>
                <autoresizingMask key="autoresizingMask"/>
                <subviews>
                    <textField hidden="YES" focusRingType="none" translatesAutoresizingMaskIntoConstraints="YES" id="PREF-defaults-header">
                        <rect key="frame" x="0.0" y="0.0" width="0.0" height="0.0"/>
                        <textFieldCell key="cell" lineBreakMode="clipping" title="Default settings for new rulers" id="PREF-defaults-header-cell">
                            <font key="font" textStyle="headline" name=".SFNS-Bold"/>
                            <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                            <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                        </textFieldCell>
                    </textField>
                    <customView translatesAutoresizingMaskIntoConstraints="NO" id="PREF-controls" customClass="RulerSettingsControlsView" customModule="powertoys" customModuleProvider="target">
                        <rect key="frame" x="20" y="64" width="380" height="420"/>
                    </customView>
                    <button verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="PREF-factory-button">
                        <rect key="frame" x="20" y="20" width="175" height="28"/>
                        <buttonCell key="cell" type="push" title="Reset to Factory Defaults" bezelStyle="inline" alignment="left" imageScaling="proportionallyDown" inset="2" id="PREF-factory-cell">
                            <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                            <font key="font" name=".AppleSystemUIFont" size="12"/>
                        </buttonCell>
                        <connections>
                            <action selector="resetToFactoryDefaults:" target="-2" id="PREF-factory-action"/>
                        </connections>
                    </button>
                </subviews>
                <constraints>
                    <constraint firstItem="PREF-controls" firstAttribute="leading" secondItem="PREF-content" secondAttribute="leading" constant="20" id="PREF-controls-leading"/>
                    <constraint firstItem="PREF-controls" firstAttribute="top" secondItem="PREF-content" secondAttribute="top" constant="16" id="PREF-controls-top"/>
                    <constraint firstAttribute="trailing" secondItem="PREF-controls" secondAttribute="trailing" constant="20" id="PREF-controls-trailing"/>
                    <constraint firstItem="PREF-controls" firstAttribute="height" constant="420" id="PREF-controls-height"/>
                    <constraint firstItem="PREF-factory-button" firstAttribute="top" secondItem="PREF-controls" secondAttribute="bottom" constant="16" id="PREF-button-below-controls"/>
                    <constraint firstItem="PREF-factory-button" firstAttribute="leading" secondItem="PREF-content" secondAttribute="leading" constant="20" id="PREF-button-leading"/>
                    <constraint firstItem="PREF-factory-button" firstAttribute="height" constant="28" id="PREF-button-height"/>
                    <constraint firstAttribute="bottom" secondItem="PREF-factory-button" secondAttribute="bottom" constant="20" id="PREF-button-bottom"/>
                </constraints>
