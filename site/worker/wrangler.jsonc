{
  // Static assets plus a small worker that writes the latest release version into the HTML (src/index.js).
  // Local preview only (`wrangler dev`). The live site runs this worker code inside the shared samhq website Worker.
  "name": "macpowertoys-site",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/", "/index.html", "/privacy", "/terms"]
  },
  "workers_dev": false
}
